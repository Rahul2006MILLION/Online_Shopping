# ==============================================================================
# BASKET Frontend Environment Variables (Example Template)
# Copy this file to .env.local for local Next.js development.
# ==============================================================================

# Backend API Base URL
# Either the backend's public URL (e.g. http://localhost:8000), or "same-origin":
# the browser calls /api/v1 on the frontend's own domain and Next.js proxies it
# to BASKET_API_PROXY_TARGET. Hosted deployments (Vercel) use "same-origin" so
# auth and CSRF cookies stay first-party.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Backend origin the Next.js server proxies to when NEXT_PUBLIC_API_URL=same-origin
# (e.g. https://basket-api.onrender.com). Server-side only, never exposed.
# BASKET_API_PROXY_TARGET=

# Environment Mode
NEXT_PUBLIC_ENVIRONMENT=development

# Razorpay Sandbox Public Key (Phase 2F)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
