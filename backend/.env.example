# ==============================================================================
# BASKET Backend Environment Variables (Example Template)
# Copy this file to .env and configure with your actual environment values.
# NEVER commit the real .env file or credentials to source control.
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="BASKET Backend"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Security
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database (System of Record)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>?ssl=<require|disable>
# Default: Local PostgreSQL on localhost:5432/basket_db
DATABASE_URL=postgresql+asyncpg://dhruv@localhost:5432/basket_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_SSL_MODE=disable

# Aiven Apache Kafka (Domain Events & Outbox)
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SSL_CA_LOCATION=infra/aiven/certs/ca.pem
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# Optional mutual TLS (alternative to SASL_SSL if client certificates are provisioned)
# KAFKA_SSL_CERTIFICATE_LOCATION=
# KAFKA_SSL_KEY_LOCATION=

# Aiven OpenSearch (Derived Search Index)
OPENSEARCH_URL=
OPENSEARCH_USERNAME=avnadmin
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX_PREFIX=basket

# Razorpay Payment Gateway (Phase 2F Sandbox Integration)
# NOTE: In production (ENVIRONMENT=production), valid live/test credentials are required.
# Default mock and placeholder values are strictly rejected by the production configuration validator.
RAZORPAY_KEY_ID=replace_with_your_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_key_secret_min_16_chars
RAZORPAY_WEBHOOK_SECRET=replace_with_your_razorpay_webhook_secret_min_16_chars
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_CONNECT_TIMEOUT_SECONDS=5.0
RAZORPAY_READ_TIMEOUT_SECONDS=10.0

# Internal Service Key (Internal Background Tasks, Reconciliation, SLA Escalation)
# NOTE: Required in production with min 32 unpredictable characters.
INTERNAL_SERVICE_KEY=replace_with_your_internal_service_key_at_least_32_chars

# ------------------------------------------------------------------------------
# Additional security / runtime settings (set real values outside development)
# ------------------------------------------------------------------------------
# Signs access/refresh JWTs. The built-in default is public: always override it
# in any shared or hosted environment (e.g. `openssl rand -hex 32`).
JWT_SECRET_KEY=replace_with_a_long_random_value
CSRF_SECRET_KEY=replace_with_a_long_random_value
# true when served over HTTPS (staging / production)
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (Vercel + Render = 2)
TRUSTED_PROXY_COUNT=0
# "kafka" (needs KAFKA_BOOTSTRAP_SERVERS) or "direct" (single instance, no broker)
OUTBOX_DISPATCH=kafka
# Container entrypoint switches (backend/docker-entrypoint.sh)
RUN_MIGRATIONS_ON_START=true
SEED_DEMO_DATA=false
